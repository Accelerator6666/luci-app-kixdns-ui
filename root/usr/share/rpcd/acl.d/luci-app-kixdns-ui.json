{
  "luci-app-kixdns-ui": {
    "description": "Grant access to the KixDNS LuCI UI",
    "read": {
      "ubus": {
        "luci.kixdns": [
          "status",
          "get_config",
          "list_backups",
          "diff_backup",
          "editor_status",
          "diagnose",
          "get_log",
          "self_check"
        ]
      }
    },
    "write": {
      "ubus": {
        "luci.kixdns": [
          "service",
          "save_config",
          "apply_config",
          "restore_last",
          "restore_backup",
          "sync_editor"
        ]
      }
    }
  }
}
