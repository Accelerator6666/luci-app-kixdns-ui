#!/bin/ash

# SPDX-License-Identifier: GPL-3.0-only
# rpcd backend for luci-app-kixdns-ui

. /usr/share/libubox/jshn.sh

CFG="/etc/kixdns/pipeline.json"
BACKUP_DIR="/etc/kixdns/backups"
INIT="/etc/init.d/kixdns"
BIN="/usr/bin/kixdns"
LOG="/tmp/kixdns.log"
EDITOR_DIR="/www/kixdns-editor"
EDITOR_FILE="$EDITOR_DIR/config_editor.html"
EDITOR_META="/etc/kixdns/editor.meta"
EDITOR_URL="https://raw.githubusercontent.com/olicesx/kixdns/main/tools/config_editor.html"
MAX_CONFIG_BYTES=524288
MAX_EDITOR_BYTES=524288

json_reply_error() {
	json_init
	json_add_boolean ok 0
	json_add_string error "$1"
	json_dump
}

json_reply_ok() {
	json_init
	json_add_boolean ok 1
	[ -n "$1" ] && json_add_string message "$1"
	json_dump
}

read_input() {
	INPUT="$(cat)"
}

arg_get() {
	jsonfilter -s "$INPUT" -e "@.$1" 2>/dev/null
}

config_valid_file() {
	[ -s "$1" ] && jsonfilter -i "$1" -e '@' >/dev/null 2>&1
}

kix_running() {
	pidof kixdns >/dev/null 2>&1
}

kix_pid() {
	pidof kixdns 2>/dev/null | awk '{print $1}'
}

config_value() {
	local file="$1" expr="$2"
	jsonfilter -i "$file" -e "$expr" 2>/dev/null
}

config_bind_udp() {
	config_value "$CFG" '@.settings.bind_udp'
}

config_bind_tcp() {
	config_value "$CFG" '@.settings.bind_tcp'
}

listener_ok() {
	local udp tcp dump
	udp="$(config_bind_udp)"
	tcp="$(config_bind_tcp)"
	dump="$(busybox netstat -lnptu 2>/dev/null)"

	if [ -n "$udp" ] && echo "$dump" | grep -F "$udp" | grep -q 'udp'; then
		return 0
	fi

	if [ -n "$tcp" ] && echo "$dump" | grep -F "$tcp" | grep -q 'tcp'; then
		return 0
	fi

	return 1
}

parse_bind() {
	# Prints: host<TAB>port. SocketAddr-style [::1]:5353 is supported.
	local bind="$1" host port
	case "$bind" in
		\[*\]:*)
			host="${bind#\[}"
			host="${host%\]:*}"
			port="${bind##*:}"
			;;
		*:*)
			host="${bind%:*}"
			port="${bind##*:}"
			;;
		*)
			host="127.0.0.1"
			port="5353"
			;;
	esac
	case "$host" in
		''|0.0.0.0) host="127.0.0.1" ;;
		'::') host="::1" ;;
	esac
	printf '%s\t%s\n' "$host" "$port"
}

health_dns() {
	command -v drill >/dev/null 2>&1 || return 0
	local bind parsed host port out rc
	bind="$(config_bind_udp)"
	[ -n "$bind" ] || bind="127.0.0.1:5353"
	parsed="$(parse_bind "$bind")"
	host="$(printf '%s' "$parsed" | cut -f1)"
	port="$(printf '%s' "$parsed" | cut -f2)"
	case "$port" in ''|*[!0-9]*) return 1 ;; esac
	out="$(timeout 6 drill -p "$port" @"$host" example.com A 2>&1)"
	rc=$?
	[ "$rc" -eq 0 ] && echo "$out" | grep -q 'rcode:'
}

latest_backup() {
	ls -1t "$BACKUP_DIR"/pipeline.json.*.bak 2>/dev/null | head -1
}

make_backup() {
	BACKUP_CREATED=""
	[ -f "$CFG" ] || return 0
	mkdir -p "$BACKUP_DIR" || return 1
	local stamp
	stamp="$(date +%Y%m%d-%H%M%S)"
	BACKUP_CREATED="$BACKUP_DIR/pipeline.json.$stamp.bak"
	cp -p "$CFG" "$BACKUP_CREATED" || return 1
	chmod 600 "$BACKUP_CREATED" 2>/dev/null || true
}

prepare_config_tmp() {
	local content="$1" tmp bytes
	[ -n "$content" ] || return 2
	bytes="$(printf '%s' "$content" | wc -c)"
	[ "$bytes" -le "$MAX_CONFIG_BYTES" ] || return 3

	mkdir -p /etc/kixdns || return 4
	tmp="${CFG}.new.$$"
	umask 077
	printf '%s\n' "$content" > "$tmp" || return 5
	if ! config_valid_file "$tmp"; then
		rm -f "$tmp"
		return 6
	fi
	PREPARED_TMP="$tmp"
	return 0
}

install_prepared_config() {
	local tmp="$1"
	make_backup || return 7
	chmod 600 "$tmp" 2>/dev/null || true
	mv -f "$tmp" "$CFG" || return 8
	return 0
}

restart_field_changes() {
	# KixDNS upstream documents these as listener / connection-pool / cache /
	# engine-construction settings that are created at process startup.
	local old="$1" new="$2" field before after changed=""
	for field in \
		bind_udp bind_tcp bind_doh doh_tls_cert doh_tls_key doh_path \
		udp_pool_size tcp_pool_size doh_pool_size dot_pool_size doq_pool_size \
		tcp_health_check_error_threshold tcp_connection_max_age_seconds \
		tcp_connection_idle_timeout_seconds doq_connection_idle_timeout_seconds \
		doq_keepalive_interval_ms doq_enable_0rtt \
		flow_control_enabled flow_control_initial_permits flow_control_min_permits \
		flow_control_max_permits flow_control_latency_threshold_ms \
		flow_control_adjustment_interval_secs \
		cache_capacity cache_max_ttl dashmap_shards geoip_db_path
	do
		before="$(config_value "$old" "@.settings.$field")"
		after="$(config_value "$new" "@.settings.$field")"
		if [ "$before" != "$after" ]; then
			changed="${changed}${changed:+, }$field"
		fi
	done
	printf '%s' "$changed"
}

restart_and_verify() {
	[ -x "$INIT" ] || return 10
	"$INIT" restart >/dev/null 2>&1 || true
	sleep 2
	kix_running || return 11
	listener_ok || return 12
	health_dns || return 13
	return 0
}

hot_reload_and_verify() {
	local before_pid="$1" after_pid
	sleep 2
	kix_running || return 21
	after_pid="$(kix_pid)"
	# Hot reload should not require process replacement. A changed PID is not
	# fatal, but it is surfaced to the caller as a restart-like event.
	listener_ok || return 22
	health_dns || return 23
	[ -z "$before_pid" ] || [ "$before_pid" = "$after_pid" ] || return 24
	return 0
}

rollback_to() {
	local backup="$1"
	[ -n "$backup" ] && [ -f "$backup" ] || return 1
	cp -f "$backup" "$CFG" || return 1
	chmod 600 "$CFG" 2>/dev/null || true
	[ -x "$INIT" ] || return 1
	"$INIT" restart >/dev/null 2>&1 || true
	sleep 2
	kix_running && listener_ok && health_dns
}

editor_hash() {
	[ -s "$EDITOR_FILE" ] || return 0
	sha256sum "$EDITOR_FILE" 2>/dev/null | awk '{print $1}'
}

editor_updated() {
	[ -f "$EDITOR_META" ] || return 0
	sed -n 's/^updated=//p' "$EDITOR_META" | head -1
}

editor_status_json() {
	local installed=0 size=0 hash="" updated=""
	if [ -s "$EDITOR_FILE" ]; then
		installed=1
		size="$(wc -c < "$EDITOR_FILE")"
		hash="$(editor_hash)"
		updated="$(editor_updated)"
	fi
	json_add_boolean editor_installed "$installed"
	json_add_int editor_size "${size:-0}"
	json_add_string editor_sha256 "$hash"
	json_add_string editor_updated "$updated"
	json_add_string editor_url "$EDITOR_URL"
	json_add_string editor_path "/kixdns-editor/config_editor.html"
}

fetch_editor() {
	local tmp="$1"
	if command -v uclient-fetch >/dev/null 2>&1; then
		uclient-fetch -q -T 30 -O "$tmp" "$EDITOR_URL"
	elif command -v wget >/dev/null 2>&1; then
		wget -q -T 30 -O "$tmp" "$EDITOR_URL"
	else
		return 31
	fi
}

validate_editor_file() {
	local file="$1" bytes
	[ -s "$file" ] || return 1
	bytes="$(wc -c < "$file")"
	[ "$bytes" -ge 50000 ] && [ "$bytes" -le "$MAX_EDITOR_BYTES" ] || return 1
	grep -Fq '<title>KixDNS 配置编辑器</title>' "$file" || return 1
	grep -Fq 'createApp' "$file" || return 1
	grep -Fq 'v-model="rawJson"' "$file" || return 1
	return 0
}

method_status() {
	local pid running enabled version listener last cfgvalid bindudp bindtcp memkb listenerok
	pid="$(kix_pid)"
	if [ -n "$pid" ]; then running=1; else running=0; fi
	if [ -x "$INIT" ] && "$INIT" enabled >/dev/null 2>&1; then enabled=1; else enabled=0; fi
	version=""
	if [ -x "$BIN" ]; then
		version="$($BIN --version 2>/dev/null | head -1)"
		[ -n "$version" ] || version="$($BIN version 2>/dev/null | head -1)"
	fi
	listener="$(busybox netstat -lnptu 2>/dev/null | grep -E 'kixdns|127\.0\.0\.1:|0\.0\.0\.0:' | head -12)"
	last="$(latest_backup)"
	if config_valid_file "$CFG"; then cfgvalid=1; else cfgvalid=0; fi
	bindudp="$(config_bind_udp)"
	bindtcp="$(config_bind_tcp)"
	memkb=0
	if [ -n "$pid" ] && [ -r "/proc/$pid/status" ]; then
		memkb="$(awk '/^VmRSS:/ {print $2; exit}' "/proc/$pid/status" 2>/dev/null)"
		case "$memkb" in ''|*[!0-9]*) memkb=0 ;; esac
	fi
	if listener_ok; then listenerok=1; else listenerok=0; fi

	json_init
	json_add_boolean ok 1
	json_add_boolean running "$running"
	json_add_boolean enabled "$enabled"
	json_add_int pid "${pid:-0}"
	json_add_int memory_kb "${memkb:-0}"
	json_add_string version "$version"
	json_add_string config_path "$CFG"
	json_add_boolean config_valid "$cfgvalid"
	json_add_string bind_udp "$bindudp"
	json_add_string bind_tcp "$bindtcp"
	json_add_string listener "$listener"
	json_add_boolean listener_ok "$listenerok"
	json_add_string last_backup "$last"
	json_add_boolean binary_exists "$([ -x "$BIN" ] && echo 1 || echo 0)"
	editor_status_json
	json_dump
}

method_service() {
	local action
	action="$(arg_get action)"
	[ -x "$INIT" ] || { json_reply_error "KixDNS init script not found"; return; }
	case "$action" in
		start|stop|restart|enable|disable)
			"$INIT" "$action" >/dev/null 2>&1 || true
			[ "$action" = "restart" ] || [ "$action" = "start" ] || sleep 1
			json_reply_ok "Service action completed: $action"
			;;
		*) json_reply_error "Unsupported service action" ;;
	esac
}

method_get_config() {
	local content last
	content="$(cat "$CFG" 2>/dev/null)"
	last="$(latest_backup)"
	json_init
	json_add_boolean ok 1
	json_add_string path "$CFG"
	json_add_string content "$content"
	json_add_string last_backup "$last"
	json_add_string version "$($BIN --version 2>/dev/null | head -1)"
	editor_status_json
	json_dump
}

method_save_config() {
	local content rc
	content="$(arg_get content)"
	prepare_config_tmp "$content"
	rc=$?
	if [ "$rc" -ne 0 ]; then
		json_reply_error "Configuration validation failed (code $rc)"
		return
	fi
	install_prepared_config "$PREPARED_TMP"
	rc=$?
	if [ "$rc" -eq 0 ]; then
		json_init
		json_add_boolean ok 1
		json_add_string message "Configuration saved. KixDNS apply was not requested."
		json_add_string backup "$BACKUP_CREATED"
		json_dump
	else
		rm -f "$PREPARED_TMP" 2>/dev/null || true
		json_reply_error "Configuration save failed (code $rc)"
	fi
}

method_apply_config() {
	local content rc backup mode reasons before_pid
	content="$(arg_get content)"
	prepare_config_tmp "$content"
	rc=$?
	if [ "$rc" -ne 0 ]; then
		json_reply_error "Configuration JSON validation failed (code $rc)"
		return
	fi

	reasons=""
	if [ -s "$CFG" ]; then
		reasons="$(restart_field_changes "$CFG" "$PREPARED_TMP")"
	else
		reasons="initial configuration"
	fi
	if [ -n "$reasons" ]; then mode="restart"; else mode="hot_reload"; fi
	before_pid="$(kix_pid)"

	install_prepared_config "$PREPARED_TMP"
	rc=$?
	if [ "$rc" -ne 0 ]; then
		rm -f "$PREPARED_TMP" 2>/dev/null || true
		json_reply_error "Configuration save failed (code $rc)"
		return
	fi
	backup="$BACKUP_CREATED"

	if [ "$mode" = "restart" ]; then
		restart_and_verify
		rc=$?
	else
		hot_reload_and_verify "$before_pid"
		rc=$?
	fi

	if [ "$rc" -eq 0 ]; then
		json_init
		json_add_boolean ok 1
		json_add_string apply_mode "$mode"
		json_add_string restart_fields "$reasons"
		json_add_string message "$([ "$mode" = "restart" ] && echo 'Configuration applied with service restart and health verification' || echo 'Configuration applied by KixDNS hot reload and health verification')"
		json_add_string backup "$backup"
		json_dump
		return
	fi

	if [ -n "$backup" ] && rollback_to "$backup"; then
		json_init
		json_add_boolean ok 0
		json_add_boolean rolled_back 1
		json_add_string apply_mode "$mode"
		json_add_string error "KixDNS failed health verification after apply (code $rc); previous configuration restored and service restarted"
		json_add_string backup "$backup"
		json_dump
	else
		json_init
		json_add_boolean ok 0
		json_add_boolean rolled_back 0
		json_add_string apply_mode "$mode"
		json_add_string error "KixDNS failed health verification after apply (code $rc) and automatic rollback failed"
		json_add_string backup "$backup"
		json_dump
	fi
}

method_restore_last() {
	local backup
	backup="$(latest_backup)"
	[ -n "$backup" ] || { json_reply_error "No backup is available"; return; }
	if rollback_to "$backup"; then
		json_init
		json_add_boolean ok 1
		json_add_string message "Last backup restored and KixDNS restarted"
		json_add_string backup "$backup"
		json_dump
	else
		json_reply_error "Failed to restore the last backup"
	fi
}

method_list_backups() {
	local file name size stamp count=0
	json_init
	json_add_boolean ok 1
	json_add_array backups
	for file in $(ls -1t "$BACKUP_DIR"/pipeline.json.*.bak 2>/dev/null | head -30); do
		[ -f "$file" ] || continue
		name="${file##*/}"
		size="$(wc -c < "$file")"
		stamp="${name#pipeline.json.}"
		stamp="${stamp%.bak}"
		json_add_object ""
		json_add_string name "$name"
		json_add_string stamp "$stamp"
		json_add_int size "${size:-0}"
		json_close_object
		count=$((count+1))
	done
	json_close_array
	json_add_int count "$count"
	json_dump
}

method_restore_backup() {
	local name backup
	name="$(arg_get name)"
	case "$name" in
		pipeline.json.*.bak) ;;
		*) json_reply_error "Invalid backup name"; return ;;
	esac
	case "$name" in */*) json_reply_error "Invalid backup name"; return ;; esac
	backup="$BACKUP_DIR/$name"
	[ -f "$backup" ] || { json_reply_error "Backup not found"; return; }
	# Save the current file first so a restore is itself reversible.
	make_backup || { json_reply_error "Unable to back up current configuration"; return; }
	if rollback_to "$backup"; then
		json_init
		json_add_boolean ok 1
		json_add_string message "Backup restored and KixDNS restarted"
		json_add_string backup "$backup"
		json_add_string previous_backup "$BACKUP_CREATED"
		json_dump
	else
		json_reply_error "Backup restore failed"
	fi
}

method_diff_backup() {
	local name backup out rc
	name="$(arg_get name)"
	case "$name" in pipeline.json.*.bak) ;; *) json_reply_error "Invalid backup name"; return ;; esac
	case "$name" in */*) json_reply_error "Invalid backup name"; return ;; esac
	backup="$BACKUP_DIR/$name"
	[ -f "$backup" ] || { json_reply_error "Backup not found"; return; }
	if ! command -v diff >/dev/null 2>&1; then
		json_reply_error "diff utility is not available on this router"
		return
	fi
	out="$(diff -u "$backup" "$CFG" 2>&1 | head -400)"
	rc=$?
	# diff returns 1 when files differ; that is a successful comparison.
	[ "$rc" -le 1 ] || { json_reply_error "diff failed"; return; }
	json_init
	json_add_boolean ok 1
	json_add_boolean identical "$([ -z "$out" ] && echo 1 || echo 0)"
	json_add_string output "$out"
	json_dump
}

method_sync_editor() {
	local tmp bytes hash now
	mkdir -p "$EDITOR_DIR" /etc/kixdns || { json_reply_error "Unable to create editor directory"; return; }
	tmp="$EDITOR_DIR/.config_editor.html.$$"
	rm -f "$tmp"
	if ! fetch_editor "$tmp"; then
		rm -f "$tmp"
		json_reply_error "Unable to download the official KixDNS editor from GitHub. Check router HTTPS/DNS/proxy connectivity."
		return
	fi
	if ! validate_editor_file "$tmp"; then
		rm -f "$tmp"
		json_reply_error "Downloaded file did not pass the KixDNS editor sanity checks"
		return
	fi
	[ ! -f "$EDITOR_FILE" ] || cp -f "$EDITOR_FILE" "$EDITOR_FILE.bak" 2>/dev/null || true
	chmod 644 "$tmp" 2>/dev/null || true
	mv -f "$tmp" "$EDITOR_FILE" || { rm -f "$tmp"; json_reply_error "Unable to install downloaded editor"; return; }
	bytes="$(wc -c < "$EDITOR_FILE")"
	hash="$(editor_hash)"
	now="$(date '+%Y-%m-%d %H:%M:%S %z')"
	umask 077
	{
		echo "updated=$now"
		echo "sha256=$hash"
		echo "source=$EDITOR_URL"
	} > "$EDITOR_META"
	json_init
	json_add_boolean ok 1
	json_add_string message "Official KixDNS config editor downloaded and installed"
	json_add_int editor_size "${bytes:-0}"
	json_add_string editor_sha256 "$hash"
	json_add_string editor_updated "$now"
	json_dump
}

method_editor_status() {
	json_init
	json_add_boolean ok 1
	editor_status_json
	json_dump
}

method_diagnose() {
	local domain qtype output rc bind parsed host port
	domain="$(arg_get domain)"
	qtype="$(arg_get qtype)"
	case "$qtype" in A|AAAA|CNAME|MX|TXT|NS|PTR|SOA|SRV) ;; *) qtype="A" ;; esac
	case "$domain" in
		''|*[!A-Za-z0-9._:-]*) json_reply_error "Invalid domain"; return ;;
	esac
	command -v drill >/dev/null 2>&1 || { json_reply_error "drill is not installed"; return; }
	bind="$(config_bind_udp)"
	[ -n "$bind" ] || bind="127.0.0.1:5353"
	parsed="$(parse_bind "$bind")"
	host="$(printf '%s' "$parsed" | cut -f1)"
	port="$(printf '%s' "$parsed" | cut -f2)"
	output="$(timeout 8 drill -p "$port" @"$host" "$domain" "$qtype" 2>&1)"
	rc=$?
	json_init
	json_add_boolean ok "$([ "$rc" -eq 0 ] && echo 1 || echo 0)"
	json_add_int rc "$rc"
	json_add_string server "$host:$port"
	json_add_string output "$output"
	json_dump
}

method_self_check() {
	local ok=1 report cn foreign bind parsed host port geoip geosite path ext
	report=""

	if kix_running; then report="${report}[PASS] kixdns process running\n"; else report="${report}[FAIL] kixdns process not running\n"; ok=0; fi
	if config_valid_file "$CFG"; then report="${report}[PASS] pipeline.json is valid JSON\n"; else report="${report}[FAIL] pipeline.json invalid or missing\n"; ok=0; fi
	if listener_ok; then report="${report}[PASS] configured KixDNS listener is active\n"; else report="${report}[FAIL] configured listener is not active\n"; ok=0; fi

	geoip="$(config_value "$CFG" '@.settings.geoip_dat_path')"
	if [ -n "$geoip" ]; then
		if [ -f "$geoip" ]; then report="${report}[PASS] GeoIP data exists: $geoip\n"; else report="${report}[FAIL] GeoIP data missing: $geoip\n"; ok=0; fi
	fi
	geosite="$(config_value "$CFG" '@.settings.geosite_data_paths[@]')"
	for path in $geosite; do
		if [ -f "$path" ]; then report="${report}[PASS] GeoSite data exists: $path\n"; else report="${report}[FAIL] GeoSite data missing: $path\n"; ok=0; fi
	done

	if command -v drill >/dev/null 2>&1; then
		bind="$(config_bind_udp)"; [ -n "$bind" ] || bind="127.0.0.1:5353"
		parsed="$(parse_bind "$bind")"; host="$(printf '%s' "$parsed" | cut -f1)"; port="$(printf '%s' "$parsed" | cut -f2)"
		cn="$(timeout 8 drill -p "$port" @"$host" www.baidu.com A 2>/dev/null)"
		if echo "$cn" | grep -q 'rcode:' && ! echo "$cn" | grep -q 'rcode: SERVFAIL'; then report="${report}[PASS] CN DNS query\n"; else report="${report}[FAIL] CN DNS query\n"; ok=0; fi
		foreign="$(timeout 8 drill -p "$port" @"$host" github.com A 2>/dev/null)"
		if echo "$foreign" | grep -q 'rcode:' && ! echo "$foreign" | grep -q 'rcode: SERVFAIL'; then report="${report}[PASS] foreign DNS query\n"; else report="${report}[FAIL] foreign DNS query\n"; ok=0; fi
	else
		report="${report}[WARN] drill is not installed; DNS query checks skipped\n"
	fi

	if [ -x /usr/bin/dae-kixdns-check ]; then
		ext="$(timeout 25 /usr/bin/dae-kixdns-check 2>&1 | tail -80)"
		report="${report}\n===== dae-kixdns-check =====\n${ext}\n"
	fi

	json_init
	json_add_boolean ok "$ok"
	json_add_string report "$(printf '%b' "$report")"
	json_dump
}

method_get_log() {
	local limit out
	limit="$(arg_get limit)"
	case "$limit" in ''|*[!0-9]*) limit=120 ;; esac
	[ "$limit" -lt 20 ] && limit=20
	[ "$limit" -gt 500 ] && limit=500
	if [ -s "$LOG" ]; then
		out="$(tail -n "$limit" "$LOG" 2>/dev/null)"
	else
		out="$(logread 2>/dev/null | grep -i kixdns | tail -n "$limit")"
	fi
	json_init
	json_add_boolean ok 1
	json_add_string output "$out"
	json_dump
}

method_clear_log() {
	if [ -e "$LOG" ]; then
		: > "$LOG" 2>/dev/null || { json_reply_error "Unable to clear KixDNS log"; return; }
	fi
	json_reply_ok "KixDNS log cleared"
}

case "$1" in
	list)
		cat <<'JSON'
{
  "status": {},
  "service": { "action": "" },
  "get_config": {},
  "save_config": { "content": "" },
  "apply_config": { "content": "" },
  "restore_last": {},
  "list_backups": {},
  "restore_backup": { "name": "" },
  "diff_backup": { "name": "" },
  "sync_editor": {},
  "editor_status": {},
  "diagnose": { "domain": "", "qtype": "A" },
  "self_check": {},
  "get_log": { "limit": 120 },
  "clear_log": {}
}
JSON
		;;
	call)
		read_input
		case "$2" in
			status) method_status ;;
			service) method_service ;;
			get_config) method_get_config ;;
			save_config) method_save_config ;;
			apply_config) method_apply_config ;;
			restore_last) method_restore_last ;;
			list_backups) method_list_backups ;;
			restore_backup) method_restore_backup ;;
			diff_backup) method_diff_backup ;;
			sync_editor) method_sync_editor ;;
			editor_status) method_editor_status ;;
			diagnose) method_diagnose ;;
			self_check) method_self_check ;;
			get_log) method_get_log ;;
			clear_log) method_clear_log ;;
			*) json_reply_error "Unknown method" ;;
		esac
		;;
	*) exit 1 ;;
esac
